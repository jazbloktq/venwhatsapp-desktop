{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Venwhatsapp",
  "version": "0.3.0",
  "identifier": "com.venwhatsapp.desktop",
  "build": {
    "frontendDist": "../settings-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "name": "WhatsApp link",
        "schemes": [
          "whatsapp"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": [
          "English"
        ],
        "installMode": "currentUser",
        "startMenuFolder": "Venwhatsapp Desktop",
        "template": "windows/installer.nsi"
      }
    }
  }
}
